# Copy to .env and fill in for local dev.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public URL for emailed links (renewal confirm, case lock forms).
# PUBLIC_BASE_URL=https://your-domain.com

# Database: PostgreSQL only (required). Create DB first, e.g. createdb client_subscription
# (or via pgAdmin). Passwords with $ characters are fine — do not use USE_SQLITE.
POSTGRES_DB=client_subscription
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: persistent connections in seconds (0 = close after each request)
# POSTGRES_CONN_MAX_AGE=60

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft Entra ID / Azure AD (App registration)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=organizations

# OAuth redirect URIs (dev), register these in each provider console:
#   http://localhost:8000/accounts/google/login/callback/
#   http://localhost:8000/accounts/microsoft/login/callback/

# IMAP for `manage.py fetch_support_inbox` (mailbox login = Company profile support email + app password)
# Gmail: imap.gmail.com  |  Microsoft 365: outlook.office365.com
SUPPORT_IMAP_HOST=imap.gmail.com
SUPPORT_IMAP_PORT=993
SUPPORT_IMAP_MAILBOX=INBOX
# false = leave messages unread after import
SUPPORT_IMAP_MARK_SEEN=true

# Graph OAuth (preferred for Microsoft 365 mailbox sync).
# By default settings re-use MICROSOFT_OAUTH_* values above.
# Uncomment to override specifically for support-inbox polling:
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# MICROSOFT_GRAPH_TENANT=organizations

# Zoho CRM (Quotations from Client renewals).
# Create a Server-based app at https://api-console.zoho.in/ (or .com)
# Redirect URI: http://localhost:8000/company/zoho/callback/
# Scopes: ZohoCRM.modules.ALL, ZohoCRM.settings.ALL, offline_access
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_DC=in
# Optional override; defaults to PUBLIC_BASE_URL + /company/zoho/callback/
# ZOHO_REDIRECT_URI=http://localhost:8000/company/zoho/callback/

# WhatsApp Cloud API (shared — leads now; other features later)
# Webhook URL: https://your-domain.com/whatsapp/webhook/
# Flow endpoint: https://your-domain.com/whatsapp/flow/?handler=lead
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v26.0
# From Meta → WhatsApp → API Setup (for whatsapp_webhook_diagnose --subscribe)
WHATSAPP_WABA_ID=
# Meta app ID (optional; for Graph API webhook registration)
WHATSAPP_META_APP_ID=
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_FLOW_HANDLER=lead
# Diagnose live webhooks: python manage.py whatsapp_webhook_diagnose --subscribe
# Paste PEM with \n newlines, or set a file path:
# WHATSAPP_FLOW_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# WHATSAPP_FLOW_PRIVATE_KEY_PATH=/path/to/private.pem
# WHATSAPP_FLOW_PRIVATE_KEY_PASSWORD=

# Welcome/menu when a customer starts a new WhatsApp conversation
# (first message, or after this many hours of inactivity)
WHATSAPP_WELCOME_INACTIVITY_HOURS=24
# auto | buttons | flow | text
WHATSAPP_WELCOME_MODE=auto
WHATSAPP_WELCOME_BODY=Welcome to Tracker365. How can we help you today?
# WHATSAPP_WELCOME_HEADER=
# WHATSAPP_WELCOME_FOOTER=
WHATSAPP_WELCOME_BUTTONS=lead:New enquiry,support:Support
# When set (and mode=auto or flow), sends a Flow CTA instead of buttons:
# WHATSAPP_WELCOME_FLOW_ID=
# WHATSAPP_WELCOME_FLOW_CTA=Open form

# Celery broker/backend.
# Default in settings is filesystem:// (no Redis/Docker needed on local Windows).
# To use Redis later, set CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=filesystem://
CELERY_RESULT_BACKEND=cache+memory://

# Combined backups (PostgreSQL dump + media archive). Requires pg_dump on PATH.
BACKUP_ENABLED=true
# BACKUP_DIR=D:\backups\sales
BACKUP_RETENTION_DAYS=14
# BACKUP_PG_DUMP=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# BACKUP_PG_RESTORE=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=0
# Manual: python manage.py create_backup
# List:    python manage.py list_backups
# Restore: python manage.py restore_backup --latest --confirm

# Run: copy this file to .env, then:
#   venv\Scripts\python manage.py migrate
#   venv\Scripts\python manage.py createsuperuser   (use email when prompted)
#   venv\Scripts\python manage.py runserver
